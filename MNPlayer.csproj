<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MNPlayer</AssemblyName>
    <RootNamespace>MNPlayer</RootNamespace>
    <StartupObject>MNPlayer.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.2.4</Version>
    <FileVersion>2.2.4.0</FileVersion>
    <Product>MN Player</Product>
    <Company>Mavi Nokta</Company>
    <Copyright>Mavi Nokta</Copyright>
    <Description>MN Player</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CA1416;CS8602;CS8600;CS8604;CS0168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\app.ico" />
    <None Include="native\libmpv-2.dll" Condition="Exists('native\libmpv-2.dll')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="libmpv-2.dll" />
    <None Include="assets\Licenses.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Licenses\Licenses.txt" />
    <Compile Remove="ci\**;installer\**;out\**;publish\**;native\**" />
  </ItemGroup>
</Project>
