<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MnIptv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/mn_black</item>
        <item name="colorPrimary">@color/mn_blue</item>
        <item name="colorPrimaryDark">@color/mn_black</item>
        <item name="colorAccent">@color/mn_blue</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:textColorPrimary">@color/mn_text_primary</item>
        <item name="android:textColorSecondary">@color/mn_text_secondary</item>
        <item name="alertDialogTheme">@style/MnDialog</item>
    </style>

    <style name="MnDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/mn_blue</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/mn_text_primary</item>
        <item name="android:textColorSecondary">@color/mn_text_secondary</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/bg_menu_item</item>
        <item name="android:selectableItemBackground">@drawable/bg_menu_item</item>
        <item name="selectableItemBackground">@drawable/bg_menu_item</item>
    </style>

    <style name="MnButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minWidth">150dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/mn_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="MnInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/mn_text_primary</item>
        <item name="android:textColorHint">@color/mn_text_muted</item>
        <item name="android:textSize">17sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="MnThinProgress" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:indeterminate">false</item>
        <item name="android:max">1000</item>
        <item name="android:progressDrawable">@drawable/progress_blue</item>
    </style>
</resources>
