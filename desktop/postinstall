#!/bin/sh
set -eu
# All settings run as the logged-in user, never as root.
console_user=$(/usr/bin/stat -f '%Su' /dev/console)
case "$console_user" in root|loginwindow|'') exit 0 ;; esac
console_uid=$(/usr/bin/id -u "$console_user")
player='/Applications/MN Player.app/Contents/MacOS/MNPlayer'
if ! /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" "$player" --configure-install; then
    echo 'Kullanıcı ayarları uygulamanın ilk açılışında yeniden tamamlanacak.'
fi
exit 0
